/USER.md
/MEMORY.md
/CLAUDE.local.md
/.claude/settings.local.json
/.instalat
/nucleu/.stare.json
/nucleu/.canar
/nucleu/.canar-refuzuri
/nucleu/.actualizare.json
/video/
/branduri/
/proprii/
/unelte/ffmpeg/
/unelte/vectorizare/
/unelte/python/

# Dependențele, la orice adâncime (nucleu/, motoare/hyperframes/).
node_modules/

# Fișierele puse de sistemul de operare.
.DS_Store
Thumbs.db

# Cache-ul Python lăsat de testele uneltei de import (unelte/import-biblioteci).
__pycache__/
