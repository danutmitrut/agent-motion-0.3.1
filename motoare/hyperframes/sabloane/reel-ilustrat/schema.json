{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mg:reel-ilustrat/1",
  "title": "date.json pentru reel-ilustrat, versiunea 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["sablon", "versiune_schema", "scene"],
  "x-mesaj": {
    "additionalProperties": "Câmpul nu există în reel-ilustrat (sigla și titlul videoului nu se pun în date.json).",
    "required": "Lipsește un câmp obligatoriu: sablon, versiune_schema sau scene."
  },
  "properties": {
    "sablon": { "const": "reel-ilustrat", "x-mesaj": { "const": "Câmpul sablon trebuie să fie exact „reel-ilustrat”." } },
    "versiune_schema": { "type": "integer", "const": 1, "x-mesaj": { "const": "date.json e scris pentru altă versiune a șablonului; reel-ilustrat acceptă doar versiune_schema 1." } },
    "format": { "enum": ["vertical"], "x-mesaj": { "enum": "reel-ilustrat are un singur format: vertical." } },
    "durata": { "type": "number", "minimum": 10, "maximum": 60, "x-mesaj": { "minimum": "Durata videoului e de cel puțin 10 s.", "maximum": "Durata videoului e de cel mult 60 s.", "type": "Durata e un număr de secunde." } },
    "brand": { "type": ["string", "null"], "pattern": "^[a-z0-9-]{2,40}$", "x-mesaj": { "pattern": "Numele brandului are 2-40 de caractere: litere mici, cifre și cratimă." } },
    "stil": { "$ref": "#/$defs/stil" },
    "semnatura": { "type": "string", "minLength": 1, "maxLength": 200, "x-mesaj": { "minLength": "Semnătura nu poate fi goală; scoate câmpul dacă nu vrei semnătură." } },
    "muzica": { "$ref": "#/$defs/muzica" },
    "scene": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": { "$ref": "#/$defs/scena" },
      "x-mesaj": { "minItems": "Reelul are cel puțin 2 scene.", "maxItems": "Reelul are cel mult 8 scene." }
    }
  },
  "$defs": {
    "hex": { "type": "string", "pattern": "^#[0-9A-Fa-f]{6}$", "x-mesaj": { "pattern": "Culoarea se scrie în hex, cu 6 cifre: #RRGGBB.", "type": "Culoarea se scrie în hex, ca text: \"#RRGGBB\"." } },
    "stil": {
      "type": "object",
      "additionalProperties": false,
      "x-mesaj": { "additionalProperties": "Câmpul nu există în stil la reel-ilustrat." },
      "properties": {
        "descriere": { "type": "string", "maxLength": 300, "x-mesaj": { "maxLength": "Descrierea stilului are cel mult 300 de caractere." } },
        "tema": { "enum": ["noapte", "hartie", "curat"], "x-mesaj": { "enum": "Tema e una dintre: noapte, hartie, curat." } },
        "culori": {
          "type": "object",
          "additionalProperties": false,
          "x-mesaj": { "additionalProperties": "În culori se pot da doar fundal, linie, accent și text." },
          "properties": {
            "fundal": { "$ref": "#/$defs/hex" },
            "linie": { "$ref": "#/$defs/hex" },
            "accent": { "$ref": "#/$defs/hex" },
            "text": { "$ref": "#/$defs/hex" }
          }
        },
        "font_titlu": { "enum": ["instrument-sans", "fraunces"], "x-mesaj": { "enum": "Fontul titlului e instrument-sans sau fraunces." } },
        "ritm": { "enum": ["calm", "normal", "alert"], "default": "normal", "x-mesaj": { "enum": "Ritmul e calm, normal sau alert." } },
        "atmosfera": { "enum": ["ceata", "plin"], "x-mesaj": { "enum": "Atmosfera e ceata sau plin." } },
        "recolorare": { "enum": ["tema", "original"], "default": "tema", "x-mesaj": { "enum": "Recolorarea e tema sau original." } }
      }
    },
    "muzica": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["fisier"],
      "x-mesaj": { "additionalProperties": "Muzica are doar fisier, volum și incepe_de_la.", "required": "Muzica are nevoie de fisier." },
      "properties": {
        "fisier": { "type": "string", "minLength": 1 },
        "volum": { "type": "number", "minimum": 0.1, "maximum": 1, "x-mesaj": { "minimum": "Volumul e între 0,1 și 1.", "maximum": "Volumul e între 0,1 și 1." } },
        "incepe_de_la": { "type": "number", "minimum": 0 }
      }
    },
    "durataScena": { "type": "number", "minimum": 2.5, "maximum": 12, "x-mesaj": { "minimum": "O scenă durează cel puțin 2,5 s.", "maximum": "O scenă durează cel mult 12 s." } },
    "eticheta": { "type": "string", "minLength": 1, "maxLength": 120, "x-mesaj": { "minLength": "Eticheta nu poate fi goală; scoate câmpul dacă nu o vrei." } },
    "marime": { "enum": ["M", "L", "XL"], "x-mesaj": { "enum": "Mărimea titlului e una dintre: M (implicit), L, XL; în pixeli nu se dă." } },
    "titlu": {
      "type": "array",
      "minItems": 1,
      "maxItems": 2,
      "items": { "type": "string", "minLength": 1, "maxLength": 120, "x-mesaj": { "minLength": "Un rând de titlu nu poate fi gol." } },
      "x-mesaj": { "minItems": "Titlul are cel puțin un rând.", "maxItems": "Titlul are cel mult 2 rânduri; împarte textul în două scene." }
    },
    "cuvinte": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": { "type": "string", "minLength": 1, "maxLength": 120 },
      "x-mesaj": { "minItems": "Lista de cuvinte are cel puțin 2 elemente.", "maxItems": "Lista de cuvinte are cel mult 5 elemente." }
    },
    "desen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "x-mesaj": { "additionalProperties": "Desenul are doar id, marime, pozitie, oglindit, ramane_pana_la, ajustare și panou.", "required": "Desenul are nevoie de id (din mg desen cauta)." },
      "properties": {
        "id": { "type": "string", "pattern": "^(od|op|p|b)-[a-z0-9-]+$", "x-mesaj": { "pattern": "Id-ul desenului începe cu od-, op-, p- sau b- (desenele brandului) și are doar litere mici, cifre și cratimă." } },
        "marime": { "enum": ["mic", "mediu", "mare"], "x-mesaj": { "enum": "Mărimea e mic, mediu sau mare." } },
        "pozitie": { "enum": ["centru", "stanga", "dreapta"], "x-mesaj": { "enum": "Poziția e centru, stanga sau dreapta." } },
        "oglindit": { "type": "boolean" },
        "ramane_pana_la": { "type": "integer", "minimum": 2, "x-mesaj": { "minimum": "ramane_pana_la e numărul unei scene ulterioare (de la 2 în sus).", "type": "ramane_pana_la e un număr întreg de scenă." } },
        "ajustare": {
          "type": "object",
          "additionalProperties": false,
          "x-mesaj": { "additionalProperties": "Ajustarea are doar dx, dy și scara." },
          "properties": {
            "dx": { "type": "number", "minimum": -200, "maximum": 200, "x-mesaj": { "minimum": "dx e între -200 și 200 px.", "maximum": "dx e între -200 și 200 px." } },
            "dy": { "type": "number", "minimum": -200, "maximum": 200, "x-mesaj": { "minimum": "dy e între -200 și 200 px.", "maximum": "dy e între -200 și 200 px." } },
            "scara": { "type": "number", "minimum": 0.7, "maximum": 1.3, "x-mesaj": { "minimum": "scara e între 0,7 și 1,3.", "maximum": "scara e între 0,7 și 1,3." } }
          }
        },
        "panou": { "type": "boolean" }
      }
    },
    "scena": {
      "type": "object",
      "required": ["tip"],
      "x-mesaj": { "required": "Fiecare scenă are un tip: desen, adunare, retea, card sau final." },
      "properties": {
        "tip": { "enum": ["desen", "adunare", "retea", "card", "final"], "x-mesaj": { "enum": "Tipul scenei e unul dintre: desen, adunare, retea, card, final." } }
      },
      "allOf": [
        { "if": { "type": "object", "properties": { "tip": { "const": "desen" } }, "required": ["tip"] }, "then": { "$ref": "#/$defs/scenaDesen" } },
        { "if": { "type": "object", "properties": { "tip": { "const": "adunare" } }, "required": ["tip"] }, "then": { "$ref": "#/$defs/scenaAdunare" } },
        { "if": { "type": "object", "properties": { "tip": { "const": "retea" } }, "required": ["tip"] }, "then": { "$ref": "#/$defs/scenaRetea" } },
        { "if": { "type": "object", "properties": { "tip": { "const": "card" } }, "required": ["tip"] }, "then": { "$ref": "#/$defs/scenaCard" } },
        { "if": { "type": "object", "properties": { "tip": { "const": "final" } }, "required": ["tip"] }, "then": { "$ref": "#/$defs/scenaFinal" } }
      ]
    },
    "scenaDesen": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tip", "desen"],
      "not": { "type": "object", "properties": { "titlu": true, "cuvinte": true }, "required": ["titlu", "cuvinte"] },
      "x-mesaj": { "additionalProperties": "Câmpul nu există la o scenă de tip desen.", "required": "Scena de tip desen are nevoie de desen.id.", "not": "Scena are și titlu, și cuvinte; păstrează doar unul." },
      "properties": {
        "tip": { "const": "desen" },
        "durata": { "$ref": "#/$defs/durataScena" },
        "eticheta": { "$ref": "#/$defs/eticheta" },
        "titlu": { "$ref": "#/$defs/titlu" },
        "marime": { "$ref": "#/$defs/marime" },
        "cuvinte": { "$ref": "#/$defs/cuvinte" },
        "desen": { "$ref": "#/$defs/desen" }
      }
    },
    "scenaAdunare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tip", "iconite"],
      "not": { "type": "object", "properties": { "titlu": true, "cuvinte": true }, "required": ["titlu", "cuvinte"] },
      "x-mesaj": { "additionalProperties": "Câmpul nu există la o scenă de tip adunare.", "required": "Scena de tip adunare are nevoie de iconite (1-6 nume Lucide).", "not": "Scena are și titlu, și cuvinte; păstrează doar unul." },
      "properties": {
        "tip": { "const": "adunare" },
        "durata": { "$ref": "#/$defs/durataScena" },
        "eticheta": { "$ref": "#/$defs/eticheta" },
        "titlu": { "$ref": "#/$defs/titlu" },
        "marime": { "$ref": "#/$defs/marime" },
        "cuvinte": { "$ref": "#/$defs/cuvinte" },
        "iconite": {
          "type": "array",
          "minItems": 1,
          "maxItems": 6,
          "items": { "type": "string", "pattern": "^[a-z0-9-]+$", "x-mesaj": { "pattern": "Numele iconiței are doar litere mici, cifre și cratimă (ca în Lucide)." } },
          "x-mesaj": { "minItems": "Scena de tip adunare are cel puțin o iconiță.", "maxItems": "Scena de tip adunare are cel mult 6 iconițe." }
        },
        "aranjare": { "enum": ["arc-sus", "rand"], "x-mesaj": { "enum": "Aranjarea e arc-sus sau rand." } }
      }
    },
    "scenaRetea": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tip"],
      "not": { "type": "object", "properties": { "titlu": true, "cuvinte": true }, "required": ["titlu", "cuvinte"] },
      "x-mesaj": { "additionalProperties": "Câmpul nu există la o scenă de tip retea.", "not": "Scena are și titlu, și cuvinte; păstrează doar unul." },
      "properties": {
        "tip": { "const": "retea" },
        "durata": { "$ref": "#/$defs/durataScena" },
        "eticheta": { "$ref": "#/$defs/eticheta" },
        "titlu": { "$ref": "#/$defs/titlu" },
        "marime": { "$ref": "#/$defs/marime" },
        "cuvinte": { "$ref": "#/$defs/cuvinte" },
        "noduri": { "type": "integer", "minimum": 3, "maximum": 6, "x-mesaj": { "minimum": "Rețeaua are 3-6 noduri.", "maximum": "Rețeaua are 3-6 noduri." } },
        "scanteie": { "type": "boolean" }
      }
    },
    "scenaCard": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tip"],
      "not": { "type": "object", "properties": { "titlu": true, "cuvinte": true }, "required": ["titlu", "cuvinte"] },
      "x-mesaj": { "additionalProperties": "Câmpul nu există la o scenă de tip card.", "not": "Scena are și titlu, și cuvinte; păstrează doar unul." },
      "properties": {
        "tip": { "const": "card" },
        "durata": { "$ref": "#/$defs/durataScena" },
        "eticheta": { "$ref": "#/$defs/eticheta" },
        "titlu": { "$ref": "#/$defs/titlu" },
        "marime": { "$ref": "#/$defs/marime" },
        "cuvinte": { "$ref": "#/$defs/cuvinte" }
      }
    },
    "scenaFinal": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tip"],
      "not": { "type": "object", "properties": { "titlu": true, "cuvinte": true }, "required": ["titlu", "cuvinte"] },
      "x-mesaj": { "additionalProperties": "Câmpul nu există la o scenă de tip final.", "not": "Scena are și titlu, și cuvinte; păstrează doar unul." },
      "properties": {
        "tip": { "const": "final" },
        "durata": { "$ref": "#/$defs/durataScena" },
        "eticheta": { "$ref": "#/$defs/eticheta" },
        "titlu": { "$ref": "#/$defs/titlu" },
        "marime": { "$ref": "#/$defs/marime" },
        "cuvinte": { "$ref": "#/$defs/cuvinte" },
        "desen": { "$ref": "#/$defs/desen" },
        "linie_accent": { "type": "boolean" },
        "cta": { "type": "string", "minLength": 1, "maxLength": 120, "x-mesaj": { "minLength": "Îndemnul nu poate fi gol; scoate câmpul dacă nu-l vrei." } }
      }
    }
  }
}
