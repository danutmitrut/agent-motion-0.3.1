{
  "permissions": {
    "allow": [
      "Bash(node nucleu/mg.mjs *)",
      "Bash(node ./nucleu/mg.mjs *)",
      "PowerShell(node nucleu/mg.mjs *)",
      "PowerShell(node ./nucleu/mg.mjs *)",
      "PowerShell(node nucleu\\mg.mjs *)",
      "PowerShell(node .\\nucleu\\mg.mjs *)"
    ],
    "deny": [
      "Edit(/motoare/**)",
      "Edit(/nucleu/**)",
      "Edit(/biblioteci/**)",
      "Edit(/video/*/build/**)",
      "Edit(/video/*/active/**)",
      "Edit(/video/*/cadre/**)",
      "Edit(/video/*/serie/**)",
      "Edit(/video/*/corecturi/**)",
      "Edit(/video/*/.cache/**)",
      "Edit(/video/*/verificare.json)",
      "Edit(/video/*/motor.lock)",
      "Edit(/video/**/*.mp4)",
      "Bash(git push:*)", "Bash(npm publish:*)",
      "PowerShell(git push:*)", "PowerShell(npm publish:*)"
    ]
  },
  "hooks": {
    "PreToolUse": [ { "matcher": "Bash|PowerShell|Write|Edit", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/nucleu/garda.mjs"] } ] } ],
    "PostToolUse": [ { "matcher": "SubagentHandback", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/nucleu/garda.mjs"] } ] } ],
    "Stop": [ { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/nucleu/garda.mjs"] } ] } ],
    "UserPromptSubmit": [ { "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/nucleu/garda.mjs"], "timeout": 20 } ] } ],
    "SubagentStop": [ { "matcher": "revizor-cadre", "hooks": [ { "type": "command", "command": "node", "args": ["${CLAUDE_PROJECT_DIR}/nucleu/garda.mjs"] } ] } ]
  },
  "autoMemoryEnabled": false,
  "enabledPlugins": { "hyperframes@hyperframes": false, "remotion@remotion": false }
}
